{
  "name": "ultron-ai",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/auth.js && node --check server/ai.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.0",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "mammoth": "1.10.0",
    "multer": "2.0.2",
    "openai": "5.12.0",
    "pdf-parse": "1.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "5.4.19"
  }
}
